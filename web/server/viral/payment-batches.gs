// Weekly settlements. All changes and notification keys commit with viral_state CAS.
function webAccounting_(init){const u=auth_(init);if(String(u.id)!==String(setting_('accountant_telegram_id')||'')&&!isDirector_(u))throw Error('Chỉ kế toán hoặc Ban giám đốc được xử lý đợt thanh toán');return u;}
function webBatchSheet_(){let s=book_().getSheetByName('PaymentBatches');if(!s){s=book_().insertSheet('PaymentBatches');s.appendRow(['id','status','groups_json','created_by','created_at','paid_by','paid_at','cancelled_by','cancelled_at','request_id']);}return s;}
function webBatches_(){return book_().getSheetByName('PaymentBatches')?rows_('PaymentBatches').filter(x=>x.id).map(x=>({...x,groups:JSON.parse(x.groups_json)})):[];}
function webReservedExpense_(id){return webBatches_().find(b=>b.status==='pending'&&b.groups.some(g=>g.bills.some(x=>String(x.id)===String(id))));}
function webPaymentRow_(sh,id){const a=sh.getDataRange().getValues(),matches=a.map((r,i)=>i>0&&String(r[0])===String(id)?i+1:0).filter(Boolean);if(matches.length!==1)throw Error('Mã phiếu hoặc đợt bị thiếu / trùng: '+id);return matches[0];}
function webExpenseSnapshot_(x){return {id:String(x.id),telegram_id:String(x.telegram_id),project:String(x.project||''),description:String(x.description||''),amount_vnd:Number(x.amount_vnd),bank_account:String(x.bank_account||'').trim(),bank_name:String(x.bank_name||'').trim(),recipient_name:String(x.recipient_name||'').trim()};}
function webExpenseKey_(x){return JSON.stringify([String(x.telegram_id),String(x.bank_account||'').replace(/\s/g,''),String(x.bank_name||'').trim().toLowerCase(),String(x.recipient_name||'').trim().toLowerCase()]);}
function webExpenseIds_(ids){if(!Array.isArray(ids)||!ids.length||ids.length>200||new Set(ids.map(String)).size!==ids.length)throw Error('Chọn từ 1 đến 200 phiếu không trùng nhau');return ids.map(String);}
function accountingExpenses(init){webAccounting_(init);const expenses=expensesWithProduction_(rows_('Expenses').filter(x=>x.id)).sort((a,b)=>String(b.created_at).localeCompare(String(a.created_at)));return {ok:true,expenses,batches:webBatches_().map(({groups_json,...x})=>x)};}
function approveExpenseBatch(init,ids){const u=webAccounting_(init);ids=webExpenseIds_(ids);const items=rows_('Expenses'),selected=ids.map(id=>items.find(x=>String(x.id)===id));if(selected.some(x=>!x||x.status!=='pending'))throw Error('Có phiếu không còn chờ duyệt. Làm mới để kiểm tra.');const now=new Date().toISOString(),sh=sheet_('Expenses');for(const x of selected){const i=webPaymentRow_(sh,x.id);sh.getRange(i,10,1,5).setValues([['approved',u.id,'',x.created_at,now]]);queueNotification_('web:bulk-approved:'+x.id,x.telegram_id,'🧾 PHIẾU CHI ĐÃ DUYỆT\nMã phiếu: '+x.id+'\n'+x.description+'\nSố tiền: '+Number(x.amount_vnd).toLocaleString('vi-VN')+' đ\nChờ kế toán thanh toán theo đợt.');}return accountingExpenses(init);}
function createPaymentBatch(init,ids,requestId){const u=webAccounting_(init);ids=webExpenseIds_(ids);requestId=String(requestId||'');if(!/^[A-Za-z0-9_-]{12,100}$/.test(requestId))throw Error('Mã yêu cầu không hợp lệ');const prior=webBatches_().find(b=>b.request_id===requestId);if(prior){if(JSON.stringify(prior.groups.flatMap(g=>g.bills.map(x=>x.id)).sort())!==JSON.stringify(ids.slice().sort()))throw Error('Mã yêu cầu đã dùng cho danh sách khác');return accountingExpenses(init);}
 const items=rows_('Expenses'),selected=ids.map(id=>items.find(x=>String(x.id)===id));if(selected.some(x=>!x||x.status!=='approved'||webReservedExpense_(x.id)))throw Error('Chỉ chọn phiếu đã duyệt, chưa thanh toán và chưa thuộc đợt khác');const groups=[];
 for(const row of selected){const x=webExpenseSnapshot_(row);if(!/^\d{6,25}$/.test(x.bank_account)||!x.bank_name||!x.recipient_name||!Number.isSafeInteger(x.amount_vnd)||x.amount_vnd<=0)throw Error('Phiếu '+x.id+' thiếu hoặc sai thông tin nhận tiền');const key=webExpenseKey_(x);let g=groups.find(g=>g.key===key);if(!g){g={id:Utilities.getUuid(),key,telegram_id:x.telegram_id,name:person_(x.telegram_id)?.name||x.telegram_id,bank_account:x.bank_account,bank_name:x.bank_name,recipient_name:x.recipient_name,total:0,bills:[]};groups.push(g);}g.bills.push(x);g.total+=x.amount_vnd;if(!Number.isSafeInteger(g.total))throw Error('Tổng tiền không hợp lệ');}
 webBatchSheet_().appendRow([Utilities.getUuid(),'pending',JSON.stringify(groups),u.id,new Date().toISOString(),'','','','',requestId]);return accountingExpenses(init);
}
function cancelPaymentBatch(init,id){const u=webAccounting_(init),b=webBatches_().find(x=>x.id===String(id));if(!b)throw Error('Không thấy đợt thanh toán');if(b.status==='cancelled')return accountingExpenses(init);if(b.status!=='pending')throw Error('Đợt đã thanh toán không thể hủy');const sh=webBatchSheet_(),i=webPaymentRow_(sh,b.id);sh.getRange(i,2).setValue('cancelled');sh.getRange(i,8,1,2).setValues([[u.id,new Date().toISOString()]]);return accountingExpenses(init);}
function payPaymentBatch(init,id,proofs=[]){const u=webAccounting_(init),b=webBatches_().find(x=>x.id===String(id));if(!b)throw Error('Không thấy đợt thanh toán');if(b.status==='paid')return accountingExpenses(init);if(b.status!=='pending')throw Error('Đợt đã hủy');if(!Array.isArray(proofs)||proofs.some(p=>!p||!b.groups.some(g=>g.id===p.group_id))||new Set(proofs.map(x=>x.group_id)).size!==proofs.length)throw Error('Danh sách chứng từ không hợp lệ hoặc trùng khoản chuyển');
 const items=rows_('Expenses');for(const g of b.groups)for(const saved of g.bills){const current=items.find(x=>String(x.id)===saved.id);if(!current||current.status!=='approved'||JSON.stringify(webExpenseSnapshot_(current))!==JSON.stringify(saved))throw Error('Phiếu '+saved.id+' đã thay đổi. Hủy đợt và lập lại để đối chiếu.');}
 // Validate every proof before writing any row or file.
 const blobs=b.groups.map(g=>{const p=proofs.find(x=>x.group_id===g.id);return !p||p.image==null||p.image===''?null:v20Bill_(p.image);}),folder=blobs.some(Boolean)?DriveApp.getFolderById(prop_('BILL_FOLDER_ID')):null,now=new Date().toISOString(),sh=sheet_('Expenses');
 b.groups.forEach((g,k)=>{const file=blobs[k]?folder.createFile(blobs[k].setName('dot_'+b.id+'_'+g.id+'.'+blobs[k].getName().split('.').pop())):null;g.payment_file_id=file?file.getId():'';g.payment_url=file?file.getUrl():'';for(const x of g.bills){const current=items.find(t=>String(t.id)===x.id),values=[...sh.getRange(webPaymentRow_(sh,current.id),10,1,12).getValues()[0]];values[0]='paid';values[8]=g.payment_file_id;values[9]=g.payment_url;values[10]=u.id;values[11]=now;sh.getRange(webPaymentRow_(sh,current.id),10,1,12).setValues([values]);}});
 const batchSh=webBatchSheet_(),index=webPaymentRow_(batchSh,b.id);batchSh.getRange(index,2,1,2).setValues([['paid',JSON.stringify(b.groups)]]);batchSh.getRange(index,6,1,2).setValues([[u.id,now]]);
 // One Telegram summary per employee for the whole batch; never one per bill.
 for(const employee of [...new Set(b.groups.map(g=>g.telegram_id))]){const groups=b.groups.filter(g=>g.telegram_id===employee),bills=groups.flatMap(g=>g.bills),total=groups.reduce((n,g)=>n+g.total,0);const lines=bills.map(x=>x.id+' · '+x.project+' · '+Number(x.amount_vnd).toLocaleString('vi-VN')+' đ');const head='💸 ĐÃ THANH TOÁN THEO ĐỢT\nMã đợt: '+b.id+'\nTổng: '+total.toLocaleString('vi-VN')+' đ · '+bills.length+' bill\n';const detail=lines.join('\n');queueNotification_('web:payment-batch:'+b.id+':'+employee,employee,head+(detail.length<3000?detail:'Xem danh sách bill trong app.')+'\n👉 Tiện ích → Báo chi phí để xem bill và ảnh chuyển khoản (nếu có).');}
 return accountingExpenses(init);
}
const webOriginalPayExpense=payV20Expense;payV20Expense=function(init,id,image){webAccounting_(init);if(webReservedExpense_(id))throw Error('Phiếu đang thuộc đợt thanh toán. Xử lý hoặc hủy đợt trước.');return webOriginalPayExpense(init,id,image);};
const webOriginalExpenseBank=updateV20ExpenseBank;updateV20ExpenseBank=function(init,id,data){auth_(init);if(webReservedExpense_(id))throw Error('Phiếu đang được kế toán gom thanh toán; liên hệ kế toán hủy đợt trước khi sửa STK.');return webOriginalExpenseBank(init,id,data);};
